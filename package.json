{
  "name": "digital-twin-character-customiser",
  "version": "1.0.0",
  "description": "Digital Twin Character Customiser Monorepo",
  "private": true,
  "workspaces": [
    "cores/*",
    "engines/*",
    "web-app"
  ],
  "scripts": {
    "build": "pnpm --dir web-app build",
    "check": "pnpm --dir web-app check",
    "deploy": "npx --yes wrangler deploy",
    "test": "pnpm --dir web-app exec vitest run --passWithNoTests"
  },
  "keywords": [
    "digital-twin",
    "3d",
    "ai",
    "customiser"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1"
}
