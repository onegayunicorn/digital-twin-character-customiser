{
  "name": "digital-twin-character-customiser",
  "version": "1.0.0",
  "description": "Digital Twin Character Customiser Monorepo",
  "private": true,
  "workspaces": [
    "cores/*",
    "engines/*",
    "web-app"
  ],
  "scripts": {
    "build": "pnpm --dir web-app build",
    "check": "pnpm --dir web-app check",
    "test": "pnpm --dir web-app exec vitest run --passWithNoTests",
    "test:webhooks": "node --test integrations/webhooks/handler.test.mjs",
    "preflight": "node scripts/identity-forge-v2/preflight.mjs",
    "build:verified": "node scripts/identity-forge-v2/build.mjs",
    "deploy:raw": "node scripts/identity-forge-v2/deploy.mjs",
    "deploy": "pnpm build:verified && pnpm deploy:raw",
    "verify:workers": "node scripts/cloudflare/verify-workers.mjs",
    "verify:workers:strict": "node scripts/cloudflare/verify-workers.mjs --strict",
    "cloudflare:build": "pnpm build:verified",
    "cloudflare:preflight": "pnpm preflight",
    "cloudflare:dry-run": "pnpm exec wrangler deploy --dry-run",
    "cloudflare:activate": "node scripts/cloudflare/activate.mjs",
    "audit:json": "pnpm audit --json",
    "ci": "pnpm install --frozen-lockfile && pnpm check && pnpm test && pnpm test:webhooks && pnpm build:verified"
  },
  "keywords": [
    "digital-twin",
    "3d",
    "ai",
    "customiser"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
