{
  "name": "digital-twin-character-customiser",
  "version": "4.1.0",
  "description": "Digital Twin Character Customizer (Aether Core) — cinematic 3D character rig, simulation engine, agent matrix evolution, and operations dashboard monorepo",
  "private": true,
  "workspaces": [
    "cores/*",
    "engines/*",
    "web-app",
    "server",
    "shared",
    "simulations",
    "pipelines",
    "tests"
  ],
  "scripts": {
    "dev": "npm run dev -w web-app",
    "build": "npm run build -w web-app",
    "preview": "npm run preview -w web-app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:lifestyle": "tsx simulations/lifestyle/run.ts",
    "sim:agent-matrix": "tsx simulations/agent-matrix/run.ts",
    "sim:telemetry": "tsx simulations/telemetry/run.ts",
    "sim:quantum": "tsx simulations/quantum-interface/run.ts",
    "sim:all": "npm run sim:lifestyle && npm run sim:agent-matrix && npm run sim:telemetry && npm run sim:quantum",
    "pipeline:telemetry": "tsx pipelines/telemetry-pipeline.ts",
    "pipeline:manifest": "tsx pipelines/manifest-generator.ts",
    "pipeline:sync": "tsx pipelines/sync-registry.ts",
    "hooks:install": "bash hooks/install-hooks.sh"
  },
  "keywords": [
    "digital-twin",
    "3d",
    "ai",
    "customiser",
    "simulation",
    "agent-matrix",
    "evolution",
    "react-three-fiber",
    "zustand"
  ],
  "author": "Aether Core",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
