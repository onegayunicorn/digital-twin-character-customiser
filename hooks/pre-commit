#!/usr/bin/env bash
# pre-commit — typecheck + fast test gate before every commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "▸ pre-commit: typechecking…"
if ! npx tsc --noEmit -p tsconfig.json 2>/dev/null; then
  echo "✖ typecheck failed — aborting commit"
  exit 1
fi

echo "▸ pre-commit: running unit tests…"
if ! npx vitest run 2>/dev/null | tail -5 | grep -q "Test Files.*passed\|Tests.*passed\|No test files"; then
  echo "✖ tests failed — aborting commit"
  exit 1
fi

echo "✔ pre-commit checks passed"
